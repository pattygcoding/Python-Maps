# Normalise line endings explicitly rather than relying on each machine's
# core.autocrlf.  Without this, a Windows working tree holds CRLF while the Linux
# CI runner holds LF, so the *same commit* builds to different asset hashes --
# measured as a one-byte difference in the emitted CSS and in the committed
# GeoJSON's trailing newline.  eol=lf makes both platforms see identical bytes.
* text=auto eol=lf

# Committed data and images are generated artefacts.  The GeoJSON is forced to LF
# rather than left alone, because Python's text mode translates "\n" to CRLF on
# Windows: without this the committed dataset differs by a byte depending on which
# machine last regenerated it.  build_data.py also opens with newline="\n" so both
# ends agree.
*.geojson text eol=lf
*.png -text
*.wasm -text
